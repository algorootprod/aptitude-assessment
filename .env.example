ENV=local
LOG_LEVEL=INFO
API_PORT=8090

# Neon Postgres. Use the DIRECT (non-pooled) connection string here and for Alembic —
# see CLAUDE.md, "Config and gotchas", for why the pooled `-pooler` endpoint needs care.
DATABASE_URL=postgresql+asyncpg://aptitude:aptitude@localhost:5432/aptitude
# Run `alembic upgrade head` automatically on process/container start (./run.sh,
# docker-compose, ECS). Set to false only on a container that must not migrate.
RUN_MIGRATIONS=true

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local dev only — the shared ElasticMQ container (see ../infra/elasticmq.conf). Unset in
# production so the AWS SDK resolves the real regional SQS endpoint.
SQS_ENDPOINT_URL=http://localhost:9324

# Nest publishes → this service subscribes (run: ./scripts/run_worker.sh signup)
SQS_USER_SIGNUP_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/algoaptitude-user-signup.fifo
SQS_USER_SIGNUP_DLQ_URL=

# This service publishes → Nest subscribes (from evaluation_report.service.store_report,
# once implemented)
SQS_EVALUATION_COMPLETED_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/algoaptitude-evaluation-completed.fifo

SQS_LONG_POLL_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_MAX_RECEIVE_COUNT=5

# Single-process mode: when true, the API process also hosts the signup consumer as a
# background task instead of running it as a separate worker process.
RUN_CONSUMERS=false

# api-service-handler (ASH) — encrypted API-key pool, stored in this service's own Postgres.
# No provider keys are consumed by anything in this pass; scaffolded ahead of Phase 2
# question generation — see CLAUDE.md, "Keep ASH".
ASH_SHARED_SECRET=change-me-to-a-long-random-string

# ---- Test assembly: the per-topic level ladder ----
# `level` maps 1:1 onto question_bank.difficulty. Every topic starts here on signup.
INITIAL_TOPIC_LEVEL=2
MIN_TOPIC_LEVEL=1
MAX_TOPIC_LEVEL=5

# DI is the one section scored 0-100 rather than by quadrant (its 5 questions share one chart
# and one topic). Strictly above/below these bands opens a promotion/demotion probation.
DI_PROMOTE_SCORE_THRESHOLD=85
DI_DEMOTE_SCORE_THRESHOLD=40

# Section clock budget = sum(expected_time_seconds of its questions) * this. The clock itself
# runs in Node; this is only the number we hand it.
TIME_BUDGET_SLACK=1.15
